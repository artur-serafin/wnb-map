# .htaccess projektu (na serwerze plik musi nazywać się dokładnie ".htaccess")
# Obowiązuje w tym folderze i wszystkich podfolderach.

# Jeśli strona jest otwarta przez HTTP, przekieruj ją na HTTPS.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Wyłącz pokazywanie zawartości katalogów (listingu plików)
Options -Indexes

# Zablokuj dostęp z przeglądarki do plików roboczych, logów i poprzednich wersji (.prev)
<FilesMatch "\.(lock|tmp|log|prev)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Przeglądarka nie zgaduje typu pliku
  Header set X-Content-Type-Options "nosniff"

  # Nie indeksuj strony ani jej zasobów przez wyszukiwarki
  Header set X-Robots-Tag "noindex, nofollow, noarchive"

  # Pozycja WnB ma zawsze być sprawdzana na serwerze
  <FilesMatch "^latest\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
